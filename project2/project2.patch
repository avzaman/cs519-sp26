+/* ------------------------------ Vince's code-----------------*/
+// rb_node wrapper
+struct extent_node {
+	struct rb_node  rb;
+	extent         *ex;
+};
+
+/* ADD THIS STRUCT TO "mm_types.h"
+ * the rb tree is like our own page table,
+ * needs to be locked when doing stuff*/
+//struct extent_pagetable {
+//	struct rb_root  root;
+//	spinlock_t      lock;
+//};
+//struct itself was moved to the types file
+
+/* Inserts new extent, only for new extent!!!
+ * DOES NOT CHECK NEW PAGE LOCATION, 
+ * THAT IS HANDLED IN "extent_rb_insert_or_add" */
+static void extent_rb_insert(struct rb_root *root, struct extent_node *en){
+	
+  	struct rb_node **link = &root->rb_node, *parent = NULL;
+	unsigned long value = en->ex->starting_phys_addr;
+
+	// walk through tree using start addr as comparator
+  	// this maintains the tree based on start addr
+	while (*link) {
+		struct extent_node *cur;
+
+		parent = *link;
+		cur = rb_entry(parent, struct extent_node, rb);
+
+		if (cur->ex->starting_phys_addr > value)
+			link = &(*link)->rb_left;
+		else
+			link = &(*link)->rb_right;
+	}
+
+	// attach and rebalance
+	rb_link_node(&en->rb, parent, link);
+	rb_insert_color(&en->rb, root);
+}
+
+/* scan whole tree linearly to see if new page is adjacent
+ * uses Angelo's helper function extent_pte_is_adjacent 
+ * need to check for 2 adjacencies in case of merge */
+static int extent_rb_find_all_adjacent(struct rb_root *root, unsigned long phys_addr,	struct extent_node *out[2]){
+	struct rb_node *node;
+	int found = 0;
+ 
+	out[0] = out[1] = NULL;
+ 
+	for (node = rb_first(root); node != NULL && found < 2; node = rb_next(node)) {
+		struct extent_node *en = rb_entry(node, struct extent_node, rb);
+ 
+		if (extent_pte_is_adjacent(en->ex, phys_addr))
+			out[found++] = en;
+	}
+	return found;
+}
+
+/* THIS IS CALLED WHEN PAGE FAULT OCCURS
+ * params: extent page table we defined, new page addr
+ *
+ * case 1 :) -> new page is adjacent, add to existing extent
+ * case 1.5 >:( -> new page is adjacent to start of one extent and end of another, merge
+ * case 2 :( -> no extent exists, make new one and insert 
+ * if new page is in between start and end extent something went rly wrong */
+int extent_rb_insert_or_add(struct extent_pagetable *pt, unsigned long phys_addr){
+	//all vars declare at top!!
+	struct extent_node *adj[2];
+	int n_adj;
+	unsigned long flags;
+	int ret = 0;
+ 	
+	struct extent_node *left_en, *right_en;
+	struct extent_node *en;
+    	extent *ex;
+
+	spin_lock_irqsave(&pt->lock, flags);
+ 
+	n_adj = extent_rb_find_all_adjacent(&pt->root, phys_addr, adj);
+ 
+	if (n_adj == 2) {
+		// CASE 1.5
+ 
+		if (adj[0]->ex->ending_phys_addr == phys_addr - 1) {
+			left_en  = adj[0];
+			right_en = adj[1];
+		} else {
+			left_en  = adj[1];
+			right_en = adj[0];
+		}
+ 
+    // use the left adacency cuz start addr is key for rb nodes
+		extent_add_adjacent(left_en->ex, phys_addr);
+ 
+		extent_merge(left_en->ex, right_en->ex);
+ 
+		rb_erase(&right_en->rb, &pt->root);
+		kfree(right_en); 
+ 
+	} else if (n_adj == 1) {
+		// CASE 1
+    		en = adj[0];
+ 
+		if (phys_addr == en->ex->starting_phys_addr - 1) {
+			rb_erase(&en->rb, &pt->root);
+			extent_add_adjacent(en->ex, phys_addr);
+			extent_rb_insert(&pt->root, en);
+		} else {
+			extent_add_adjacent(en->ex, phys_addr);
+		}
+ 
+	} else {
+		// CASE 2
+		ex = kmalloc(sizeof(extent), GFP_ATOMIC);
+		if (!ex) {
+			ret = -ENOMEM;
+			goto out;
+		}
+ 
+		en = kmalloc(sizeof(struct extent_node),GFP_ATOMIC);
+		if (!en) {
+			kfree(ex);
+			ret = -ENOMEM;
+			goto out;
+		}
+ 
+		extent_init(ex, phys_addr);
+		en->ex = ex;
+		extent_rb_insert(&pt->root, en);
+	}
+ 
+out:
+	spin_unlock_irqrestore(&pt->lock, flags);
+	return ret;
+}
+
+/* helper for extent_rb_insert_or_add
+ * checks every node if new page is in between start and end
+ * uses Angelos helper function extent_pte_containts */
+static struct extent_node *extent_rb_find_containing(struct rb_root *root, unsigned long phys_addr)
+{
+	struct rb_node *node;
+
+	for (node = rb_first(root); node != NULL; node = rb_next(node)) {
+		struct extent_node *en = rb_entry(node, struct extent_node, rb);
+
+		if (extent_pte_contains(en->ex, phys_addr))
+			return en;
+	}
+	return NULL;
+}
+
+/* CALLED WHENEVER A PAGE IS FREED
+ *
+ * case 1 :) -> page is start or end, call Angelo's trim func
+ * case 2 :( -> page is in middle, call Angelo's split func, add 2 new to rb tree*/
+int extent_rb_remove_page(struct extent_pagetable *pt, unsigned long phys_addr){
+	//all var declare at top!!!
+	struct extent_node *old_en;
+	unsigned long flags;
+	int ret = 0;
+
+	extent *right_ex;
+    	struct extent_node *left_en;
+    	struct extent_node *right_en;
+    	int was_start;
+
+	spin_lock_irqsave(&pt->lock, flags);
+
+  	// find freed page extent
+	old_en = extent_rb_find_containing(&pt->root, phys_addr);
+	if (!old_en) {
+    		// shouldn't happen but just in case ;)
+		ret = -EINVAL;
+		goto out;
+	}
+
+  	// CASE 1
+	if (phys_addr == old_en->ex->starting_phys_addr ||
+	    phys_addr == old_en->ex->ending_phys_addr) {
+
+		was_start = (phys_addr == old_en->ex->starting_phys_addr);
+
+		if (old_en->ex->pgcount == 1) {
+			/* Last page in the extent — remove it entirely */
+			rb_erase(&old_en->rb, &pt->root);
+			kfree(old_en->ex);
+			kfree(old_en);
+			goto out;
+		}
+
+		if (was_start) {
+			/*
+			 * Key is about to change (starting_phys_addr moves
+			 * forward by one).  Remove, trim, re-insert.
+			 */
+			rb_erase(&old_en->rb, &pt->root);
+			extent_trim(old_en->ex, phys_addr);
+			extent_rb_insert(&pt->root, old_en);
+		} else {
+			/* Tail trim — key unchanged, update in place. */
+			extent_trim(old_en->ex, phys_addr);
+		}
+
+	// CASE 2
+	} else {
+    
+    		// only need new right extent, resue old left
+   		// use 2 new wrappers to reinsert
+		//extent *right_ex;
+		//struct extent_node *left_en;
+		//struct extent_node *right_en;
+	
+		right_ex = kmalloc(sizeof(extent), GFP_ATOMIC);
+		if (!right_ex) {
+			ret = -ENOMEM;
+			goto out;
+		}
+
+		left_en = kmalloc(sizeof(struct extent_node), GFP_ATOMIC);
+		if (!left_en) {
+			kfree(right_ex);
+			ret = -ENOMEM;
+			goto out;
+		}
+
+		right_en = kmalloc(sizeof(struct extent_node), GFP_ATOMIC);
+		if (!right_en) {
+			kfree(right_ex);
+			kfree(left_en);
+			ret = -ENOMEM;
+			goto out;
+		}
+
+    		// Angelo's split func
+		extent_split(old_en->ex, phys_addr, right_ex);
+
+    		// remove old wrapper and put both halves into their new wrappers	
+		rb_erase(&old_en->rb, &pt->root);
+		left_en->ex = old_en->ex;
+		kfree(old_en);
+		right_en->ex = right_ex;
+
+		// put em back in tree, should not have to check
+		extent_rb_insert(&pt->root, left_en);
+		extent_rb_insert(&pt->root, right_en);
+	}
+
+out:
+	spin_unlock_irqrestore(&pt->lock, flags);
+	return ret;
+}
+                                                   
+/* CALL WHEN PROCESS EXITS (exit_mmap)                                    
+ * this is just for assignment to report the ending extents of process */   
+int extent_rb_count(struct extent_pagetable *pt)
+{                                                                          
+        struct rb_node *node;                                             
+        int count = 0;                                                      
+                         
+        for (node = rb_first(&pt->root); node != NULL; node = rb_next(node))
+                count++;                     
+                                                                          
+        return count;                                                     
+}                                                                           
+                             
+/* CALL ON PROCESS EXIT                        
+ * FREES THE RB TREE                                                   
+ * NEED TO CALL!!!! */                                                
+void extent_rb_destroy(struct extent_pagetable *pt)
+{                          
+        struct rb_node *node;        
+        unsigned long flags;                            
+                                
+        spin_lock_irqsave(&pt->lock, flags);
+
+        node = rb_first(&pt->root);
+        while (node) {
+                struct extent_node *en = rb_entry(node, struct extent_node, rb);
+                node = rb_next(node);                    /* advance before erase */
+                rb_erase(&en->rb, &pt->root);
+                kfree(en->ex);   /* free the extent struct itself */
+                kfree(en);        /* free the tree wrapper        */
+        }
+
+        spin_unlock_irqrestore(&pt->lock, flags);
+}
