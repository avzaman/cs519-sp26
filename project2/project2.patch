+
+/*		DEFINITION OF EXTENT	*/
+
+//code assumes all extents are kmalloc'd in caller functions!
+
+//this will contain the proper content
+//kernel linked lists represent "themselves????" as nodes "inside of themselves???/"
+struct extent_page {
+	unsigned long page;
+	struct list_head node;
+};
+
+//represents a contiguous set of physical pages
+typedef struct {
+	struct list_head extent_pagelist;
+	long pgcount;							//number of pages in this extent
+	unsigned long starting_phys_addr;
+	unsigned long ending_phys_addr;
+} extent;
+
+//Creates a new extent with exactly 1 PTE
+int extent_init(extent* ex, unsigned long pte){
+	//var declares should be at top of funcs
+	struct extent_page *first;
+	//set the extent structure fields
+	ex->starting_phys_addr = pte;
+	ex->ending_phys_addr = pte;
+	ex->pgcount = 1;
+	//create the "pointer to the linked list"
+	INIT_LIST_HEAD(&ex->extent_pagelist);
+
+
+	first = kmalloc(sizeof(struct extent_page), GFP_KERNEL);
+	if(!first) return -ENOMEM;
+	first->page = pte;
+	
+	//add the node to the new linked list
+	list_add(&first->node, &ex->extent_pagelist);
+	return 0;
+};
+
+//destroy an extent structure if it has no pages
+//also frees memory
+int extent_destroy(extent* ex){
+	if(ex->pgcount > 0){
+		return -1;
+	}
+	kfree(ex);
+	return 0;
+}
+
+//destroy an extent structure if it has pages
+//also frees its memory
+//dangerous to use so i don't use it anywhere here
+int extent_complete_destroy(extent* ex){
+	//var declares need be at top of func
+	struct extent_page *curr_page;
+	struct extent_page *temp;		//to prevent concurrent modification error
+	//check number of pages
+	if(ex->pgcount == 0){
+		return -1;
+	}
+
+	list_for_each_entry_safe(curr_page, temp, &ex->extent_pagelist, node) {
+		list_del(&curr_page->node);		//remove item from linked list
+		kfree(curr_page);			//free memory	
+	}
+
+	//free the extent buffer
+	kfree(ex);
+
+	return 0;
+}
+
+int extent_add_adjacent(extent* ex, unsigned long pte){
+	//new pte is before the existing rang
+
+    //run the necessary checks
+	if(pte == ex->starting_phys_addr-1){
+        struct extent_page *new = kmalloc(sizeof(struct extent_page), GFP_KERNEL);
+        if(!new) return -ENOMEM;
+	new->page = pte;
+		ex->starting_phys_addr = pte;
+		list_add(&new->node, &ex->extent_pagelist);
+	}else
+	//new pte is after the existing range
+	if(pte == ex->ending_phys_addr+1){
+        struct extent_page *new = kmalloc(sizeof(struct extent_page), GFP_KERNEL);
+        if(!new) return -ENOMEM;
+	new->page = pte;
+		ex->ending_phys_addr = pte;
+		list_add_tail(&new->node, &ex->extent_pagelist);
+	}else{
+		//pte is non-contiguous, a mistake was made
+		return -1;
+	}
+
+	ex->pgcount = ex->pgcount+1;
+
+	return 0;
+	
+}
+
+int extent_pte_is_start_or_end(extent* ex, unsigned long pte){
+	if(pte == ex->ending_phys_addr || pte == ex->starting_phys_addr){
+		return 1;
+	}
+	return 0;
+}
+
+int extent_pte_is_adjacent(extent* ex, unsigned long pte){
+	if(pte == ex->ending_phys_addr+1 || pte == ex->starting_phys_addr-1){
+		return 1;
+	}
+	return 0;
+}
+
+int extent_pte_is_before(extent* ex, unsigned long pte){
+	if(pte < ex->starting_phys_addr){
+		return 1;
+	}
+	return 0;
+}
+
+int extent_pte_is_after(extent* ex, unsigned long pte){
+	if(pte > ex->ending_phys_addr){
+		return 1;
+	}
+	return 0;
+}
+
+int extent_pte_contains(extent* ex, unsigned long pte){
+	if(pte >= ex->starting_phys_addr && pte <= ex->ending_phys_addr){
+		return 1;
+	}
+	return 0;
+}
+
+int extent_pte_contains_foreach(extent* ex, unsigned long pte){
+
+	struct extent_page *curr_page;
+
+	list_for_each_entry(curr_page, &ex->extent_pagelist, node) {
+		if (curr_page->page == pte){
+				return 1;
+		}
+	}
+	return 0;
+}
+
+int extents_are_adjacent(extent* ex1, extent* ex2){
+	//ex1 <-> ex2
+	if(ex1->ending_phys_addr == ex2->starting_phys_addr-1 || ex2->ending_phys_addr == ex1->starting_phys_addr-1){
+		return 1;
+	}
+	return 0;
+}
+
+//NOT FINISHED YET
+//split an extent into two separate extents WITHOUT pte
+//which occurs because a page in the middle is being freed
+//src_ex will contain the modified left part of the extent (pages to the left of the removed page)
+//new_right_half will contain the new right part of the old extent (pages to the right of the removed page)
+//please provide an empty buffer on the right that is already kmalloc'd
+//memory destruction is handled here
+int extent_split(extent* src_ex, unsigned long pte, extent* new_right_half){
+	//var declares need to be at top of func
+	struct extent_page *curr_page;
+    	struct extent_page *temp;
+	//don't split if extent doesn't contain the delimiter pte
+	if(!extent_pte_contains(src_ex, pte)){
+		return -1;	
+	}
+
+	//don't split if the pte is on the edge
+	if(extent_pte_is_start_or_end(src_ex, pte)){
+		return -1;	
+	}
+
+	//we can assume the list has 3 or more elements here
+
+	//make a new right page, it will not include the pte
+	new_right_half->pgcount = src_ex->ending_phys_addr-pte;
+	new_right_half->starting_phys_addr = pte+1;
+	new_right_half->ending_phys_addr = src_ex->ending_phys_addr;
+	INIT_LIST_HEAD(&new_right_half->extent_pagelist);
+
+	list_for_each_entry_safe(curr_page, temp, &src_ex->extent_pagelist, node) {
+		if (curr_page->page == pte){	//find the pte in question
+
+			//every node after the pte in the old list is put into the list
+			list_cut_position(&new_right_half->extent_pagelist, &src_ex->extent_pagelist, &curr_page->node);
+
+			//remove from the old list the page with the pte
+			list_del(&curr_page->node);
+			kfree(curr_page);
+
+			break;
+		}
+	}
+
+	//update the original page to reflect the changes in the page list
+	src_ex->pgcount = pte-(src_ex->starting_phys_addr);
+	src_ex->ending_phys_addr = pte-1;
+
+	return 0;
+	
+}
+
+//merge two extents together after performing the appropriate checks
+//to_ex will contain all of the pages from from_ex,
+//and from_ex will be destroyed
+int extent_merge(extent* to_ex, extent* from_ex){
+	//var declares need to be at top of func
+	struct extent_page *curr_page;
+    	int i;
+	
+	if(!extents_are_adjacent(to_ex, from_ex)){
+		//can't merge nonadjacent extents
+		return -1;
+	}
+
+	if(to_ex->pgcount == 0 || from_ex->pgcount == 0){
+		//useless to merge nothing
+		return -1;
+	}
+	
+	//to_ex <-> from_ex
+	if(to_ex->ending_phys_addr == from_ex->starting_phys_addr-1){
+		//we need the last element of to_ex
+		list_for_each_entry(curr_page, &to_ex->extent_pagelist, node){
+			//doing nothing will let us achieve this?
+		}
+		//elements from "from" continue from the last element in "to"
+		list_splice(&from_ex->extent_pagelist, &curr_page->node);
+
+		to_ex->pgcount += from_ex->pgcount;
+		to_ex->ending_phys_addr = from_ex->ending_phys_addr;
+		from_ex->pgcount = 0;
+		extent_destroy(from_ex);
+
+		return 0;
+	}
+	else
+	//from_ex <-> to_ex
+	if(from_ex->ending_phys_addr == to_ex->starting_phys_addr-1){
+		//we need the last element of to_ex
+		list_for_each_entry(curr_page, &to_ex->extent_pagelist, node){
+			//doing nothing will let us achieve this?
+		}
+		//elements from "from" continue from the last element in "to"
+		//so we end up in a weird position here
+		//where we can end up with something like (5-6-7-8)(1-2-3-4.)
+		list_splice(&from_ex->extent_pagelist, &curr_page->node);
+
+		//take the element at the head, put at in the tail, for many elements as were added
+		for(i = 0; i < from_ex->pgcount; i++){
+			list_rotate_left(&to_ex->extent_pagelist);
+		}
+
+		to_ex->pgcount += from_ex->pgcount;
+		to_ex->starting_phys_addr = from_ex->starting_phys_addr;
+		from_ex->pgcount = 0;
+
+		extent_destroy(from_ex);
+		return 0;
+	}
+	//pages must be nonadjacent, but not caught by above checks
+	return 1;
+}
+
+//remove the first or last address in an extent
+//which occurs because a page on either end is being freed
+int extent_trim(extent* ex, unsigned long pte){
+	//declares at top of func
+	struct extent_page *curr_page;
+	struct extent_page *temp;		//to prevent concurrent modification error
+	//run the necessary checks
+	if(!extent_pte_is_start_or_end(ex, pte)){
+		//pte is non-contiguous
+		return -1;
+	}
+
+	//move ending address backwards
+	if(pte == ex->ending_phys_addr && ex->pgcount > 1){
+		ex->ending_phys_addr = ex->ending_phys_addr-1;
+	}
+	else
+	//move beginning address forwards
+	if(pte == ex->starting_phys_addr && ex->pgcount > 1){
+		ex->starting_phys_addr = ex->starting_phys_addr+1;
+	}
+
+	//for each loop to remove the thing
+	//curr_page is a pointer to the linked list entry
+	//&ex->extent_pagelist is the head of the list to be searched in
+	//node is what the node representation in each linked list element is called
+
+
+	
+	list_for_each_entry_safe(curr_page, temp, &ex->extent_pagelist, node) {
+		if (curr_page->page == pte){
+				list_del(&curr_page->node);
+				kfree(curr_page);
+		}
+		break;
+	}
+
+	ex->pgcount = ex->pgcount-1;	//decrement page count
+	//be sure to properly destroy the extent if there are no pages
+
+	return 0;
+}
